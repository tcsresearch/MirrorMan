########## ShellCheck - Disable Unnecessary Checks #########
# shellcheck source=/dev/null
# shellcheck disable=SC2034  # Unused variables left for readability
#

########## Sanity Checker ##########


function SanityChecker_FileExists() {
# Check if the file exists and is a regular file
# TODO: Determine if a .bfunc or .conf file.
# TODO: Add INI file detection also w/ ReadINI sourcing. 
        if [ ! -f "$1" ]; then
                cecho red " ERROR! Functions File $1 Not Found.  Quitting..."
                return 1
        else
                cecho yellow "Sourcing Functions File: $1..."
                source "$1" # && echo "Sourcing: $1..."
        fi
}

# Alias of SanityChecker_FileExists.
# FIXME: When using this alias function, it incorrectly assumes all files are not found.
function SanityChecker() {
	SanityChecker_FileExists
}

function SanityChecker_FolderExists() {
# Check if the folder exists.
# TODO: Add check to confirm folder is not empty.
# TODO: Prompt to create folder if it doesn't exist.
	if [ ! -f "$1" ]; then
                cecho red " ERROR! Folder $1 Not Found.  Quitting..."
                return 1
        else
                cecho yellow "Sourcing Functions Folder: $1..."
                source "$1" # && echo "Sourcing: $1..."
        fi
}

